{
  "name": "gamenightly-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:cf": "npm run build && wrangler dev -c wrangler.jsonc -c wrangler.sessions.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "deploy:api": "wrangler deploy -c wrangler.sessions.jsonc"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}
